{
  "name": "{{MARCA_APP}}",
  "short_name": "{{MARCA_NOMBRE}}",
  "description": "Marca tu asistencia con GPS, elige tus horarios y registra el cuadre de tu turno.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
