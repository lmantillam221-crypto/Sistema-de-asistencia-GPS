# Puerto HTTP del servidor
PORT=3000
# Archivo de la base de datos (SQLite). Se crea solo.
DB_PATH=./data/asistencia.db
# production | development
NODE_ENV=production
# Detrás de un proxy (Render, Railway, Nginx, Cloudflare): pon 1 para leer la IP real y exigir HTTPS en cookies.
TRUST_PROXY=1
# Duración de la sesión en días
SESSION_DAYS=30
# Primer administrador: se crea al arrancar si no existe ningún administrador.
ADMIN_CODIGO=admin
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NOMBRE=Administración
# Modo demostración: habilita el reloj simulado, el simulador de GPS y los datos de ejemplo.
# NUNCA lo actives en el sistema real.
DEMO_MODE=0
